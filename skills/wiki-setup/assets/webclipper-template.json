{
  "schemaVersion": "0.1.0",
  "name": "LLM Wiki source",
  "behavior": "create",
  "noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}}-{{title|kebab|safe_name}}",
  "path": "raw/inbox",
  "noteContentFormat": "{{content}}",
  "properties": [
    {
      "name": "captured",
      "value": "{{date|date:\"YYYY-MM-DD\"}}",
      "type": "date"
    },
    {
      "name": "source_type",
      "value": "web",
      "type": "text"
    },
    {
      "name": "title",
      "value": "{{title}}",
      "type": "text"
    },
    {
      "name": "author",
      "value": "{{author}}",
      "type": "text"
    },
    {
      "name": "published",
      "value": "{{published|date:\"YYYY-MM-DD\"}}",
      "type": "date"
    },
    {
      "name": "url",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "site",
      "value": "{{site}}",
      "type": "text"
    },
    {
      "name": "description",
      "value": "{{description}}",
      "type": "text"
    },
    {
      "name": "captured_by",
      "value": "web-clipper",
      "type": "text"
    },
    {
      "name": "ingested",
      "value": "false",
      "type": "text"
    }
  ],
  "triggers": []
}
